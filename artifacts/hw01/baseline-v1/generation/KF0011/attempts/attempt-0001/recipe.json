{"variables": [{"name": "outer_d", "value": 70.1, "note": "Наружный диаметр по чертежу"}, {"name": "thickness", "value": 33, "note": "Ширина венца по чертежу"}, {"name": "bore_d", "value": 32, "note": "Диаметр сквозного отверстия"}, {"name": "key_width", "value": 10, "note": "Ширина шпоночного паза"}, {"name": "key_height", "value": 35.3, "note": "От низа отверстия до дна шпоночного паза"}], "steps": [{"op": "sketch", "id": "blank_profile", "plane": "XY", "constrain": true, "items": [{"type": "circle", "args": [0, 0, {"expr": "outer_d/2"}]}]}, {"op": "extrude", "id": "blank", "sketch": "blank_profile", "depth": {"expr": "thickness"}}, {"op": "sketch", "id": "bore_profile", "plane": "XY", "constrain": true, "items": [{"type": "circle", "args": [0, 0, {"expr": "bore_d/2"}]}]}, {"op": "cut", "id": "bore", "sketch": "bore_profile", "through": true}, {"op": "sketch", "id": "keyway_profile", "plane": "XY", "constrain": true, "items": [{"type": "rect", "args": [{"expr": "-key_width/2"}, 0, {"expr": "key_width/2"}, {"expr": "key_height-bore_d/2"}]}]}]}